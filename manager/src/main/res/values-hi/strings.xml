    <string name="home_terminal_title">टर्मिनल ऐप्स में Shevery का उपयोग करें</string>
    <string name="home_terminal_description">अपने पसंदीदा टर्मिनल ऐप्स में Shevery के माध्यम से कमांड चलाएँ</string>
    <string name="terminal_tutorial_1">सबसे पहले, फ़ाइलों को जहाँ चाहें वहाँ एक्सपोर्ट करें। आपको दो फ़ाइलें मिलेंगी, %1$s और %2$s।</string>
    <string name="terminal_tutorial_1_description">यदि चयनित फ़ोल्डर में एक ही नाम की फ़ाइलें हैं, तो वे हटा दी जाएँगी।\n\nनिर्यात फ़ंक्शन SAF (Storage Access Framework) का उपयोग करता है। रिपोर्ट किया गया है कि MIUI SAF के फ़ंक्शन को तोड़ देता है। यदि आप MIUI का उपयोग कर रहे हैं, तो आपको फ़ाइल को Shevery की APK से निकालना या GitHub से डाउनलोड करना पड़ सकता है।</string>
    <string name="terminal_export_files">फ़ाइलें निर्यात करें</string>
    <string name="terminal_tutorial_2">फिर, किसी भी टेक्स्ट एडिटर का उपयोग करके %1$s खोलें और संपादित करें।</string>
    <string name="terminal_tutorial_2_description">उदाहरण के लिए, यदि आप %1$s में Shevery का उपयोग करना चाहते हैं, तो आपको %2$s को %3$s से बदलना चाहिए (%4$s %1$s का पैकेज नाम है)।</string>
    <string name="terminal_tutorial_3">अंत में, फ़ाइलों को किसी ऐसी जगह पर ले जाएँ जहाँ आपकी टर्मिनल ऐप पहुँच सके, आप Shevery के माध्यम से कमांड चलाने के लिए %1$s का उपयोग कर पाएँगे।</string>
    <string name="terminal_tutorial_3_description">कुछ सुझाव: %1$s को execute अनुमति दें और इसे %2$s में जोड़ें, आप %1$s का सीधे उपयोग कर पाएंगे।</string>
