    <string name="paring_code_is_wrong">La pariga kodo estas malĝusta.</string>
    <string name="cannot_connect_port">Ne eblas konekti al la sendrata depana servo.</string>
    <string name="dialog_wireless_adb_not_enabled">Sendrata depanado ne estas ebligita. Noto: antaŭ Android 11, por ebligi sendratan depanadon, komputila konekto estas nepra.</string>
    <string name="dialog_adb_pairing_message"><![CDATA[Bonvolu komenci la parigon per la jenaj paŝoj: "Disvolvopcioj" - "Sendrata depanado" - "Parigi aparaton per pariga kodo". Post kiam la pariga procezo komenciĝos, vi povos enigi la parigan kodon.]]></string>
    <string name="adb_pairing_requires_multi_window">Bonvolu unue eniri split-ekranan (multfenestran) reĝimon.</string>
    <string name="adb_pairing_requires_multi_window_reason">La sistemo postulas, ke la pariga dialogo ĉiam estu videbla; uzi dividitan ekranan reĝimon estas la sola maniero, por ke ĉi tiu aplikaĵo kaj la sistema dialogo estu videblaj samtempe.</string>
    <string name="adb_error_key_store">Ne eblas generi ŝlosilon por sendrata depanado. Ĉi tio eble estas ĉar la KeyStore-mekanismo de ĉi tiu aparato estas rompita.</string>
    <string name="adb_pair_required">Bonvolu unue trairi la parigŝtupon.</string>
    <string name="notification_settings">Opcioj pri sciigoj</string>
    <string name="adb_pairing_tutorial_title">Parigu Shevery kun via aparato</string>
    <string name="adb_pairing_tutorial_content_notification">Noto de Shevery helpos vin kompletigi la parigon.</string>
    <string name="adb_pairing_tutorial_content_steps"><![CDATA[Eniru "Disvolvopcioj" - "Sendrata depanado". Tuŝu "Parigu aparaton per pariga kodo", vi vidos sesciferan kodon.]]></string>
    <string name="adb_pairing_tutorial_content_enter_pairing_code">Enigu la kodon en la sciigo por kompletigi la parigon.</string>
    <string name="adb_pairing_tutorial_content_notification_blocked">Por la parigprocezo vi devas interagi kun sciigo de Shevery. Bonvolu permesi al Shevery afiŝi sciigojn.</string>
    <string name="adb_pairing_tutorial_content_miui"><![CDATA[Uzantoj de MIUI eble bezonos ŝanĝi la stilon de sciigoj de "Notification" al "Android" en la sistemaj agordoj sub "Notification" - "Notification shade".]]></string>
    <string name="adb_pairing_tutorial_content_miui_2">Alie, eble vi ne povos enigi la parigkodon el la sciigo.</string>
    <string name="adb_pairing_tutorial_content_left_is_clickable"><![CDATA[Bonvolu noti, ke la maldekstra parto de la opcio "Senfada depanado" estas klakebla; tuŝi ĝin malfermos novan paĝon. Nur ŝalti la ŝaltilon dekstre estas malĝusta.]]></string>
    <string name="adb_pairing_tutorial_content_finish">Reen al Shevery kaj startu Shevery.</string>
    <string name="adb_pairing_tutorial_content_network">Shevery bezonas aliri la lokan reton. Ĝi estas kontrolata per la reta permeso.</string>
    <string name="adb_pairing_tutorial_content_network_limation_not_foreground">Kelkaj sistemoj (kiel MIUI) malpermesas al programoj aliri la reton kiam ili ne estas videblaj, eĉ se la programo normale uzas antaŭgrundan servon. Bonvolu malŝalti la baterio-optimumigajn funkciojn por Shevery en tiaj sistemoj.</string>
    <string name="home_root_title">Komenco (por radikitaj aparatoj)</string>
    <string name="home_root_description">Krome, Shevery povas esti aŭtomate startigita ĉe ekŝalto. Se ne, bonvolu kontroli, ĉu via sistemo aŭ triapartiaj iloj limigis Shevery. Vi povas konsulti %s.</string>
    <string name="home_root_description_sui">Se vi uzas Magisk, vi povas provi %1$s. Por root-uzantoj, ĝi eventuale anstataŭigos Shevery. Rimarku, ke ekzistantaj aplikoj devas iomete ŝanĝiĝi por uzi %2$s.</string>
