    <string name="home_adb_description"><![CDATA[Por aparatoj sen root, vi devas uzi adb por lanĉi Shevery (postulas komputilan konekton). Ĉi tiu procezo devas esti ripetita ĉiufoje kiam la aparato estas restartigita. Bonvolu <b><a href="%1$s">legi la helpon</b>.]]></string>
    <string name="home_adb_dialog_view_command_notice">Estas kelkaj aliaj konsideroj; bonvolu unue konfirmi, ke vi legis la helpon.</string>
    <string name="home_wireless_adb_title">Komencu per sendrata depanado</string>
    <string name="home_wireless_adb_description">En Android 11 aŭ pli nova, vi povas ebligi sendratan depanadon kaj lanĉi Shevery rekte de via aparato, sen konekti ĝin al komputilo. Bonvolu unue konsulti la paŝon-post-paŝan gvidilon.</string>
    <string name="home_wireless_adb_description_pre_11">Antaŭ Android 11, por ebligi sendratan depanadon necesis konekti al komputilo.</string>
    <string name="home_wireless_adb_view_guide_button">Paŝo-post-paŝa gvidilo</string>
    <string name="home_local_network_title">Loka retaliro</string>
    <string name="home_local_network_description">Senfada depanado postulas %1$s en ĉi tiu Android-versio.</string>
    <string name="home_local_network_granted">%1$s estas koncedita.</string>
    <string name="home_local_network_missing">%1$s ne estas koncedita.</string>
    <string name="home_local_network_grant">Donu aliron</string>
    <string name="home_local_network_permission_denied">Por sendrata depanado necesas aliro al la loka reto.</string>
    <string name="dialog_adb_discovery">Serĉante senfadenan erar-detektan servon</string>
    <string name="dialog_adb_discovery_message"><![CDATA[Bonvolu ebligi "Senfadenan depurigadon" en "Disvolvopcioj". "Senfadena depurigado" estas aŭtomate malŝaltita kiam la reto ŝanĝiĝas. Noto: ne malŝaltu "Disvolvopciojn" aŭ "USB-depurigadon", alie Shevery ĉesos.]]></string>
    <string name="dialog_adb_discovery_message_toggle_wireless_debugging"><![CDATA[Bonvolu provi malŝalti kaj reŝalti "Sendratan depanadon", se ĝi daŭre serĉas.]]></string>
