    <string name="app_management_dialog_adb_is_limited_title">La permeso de adb estas limigita</string>
    <string name="app_management_dialog_adb_is_limited_message"><![CDATA[Estas tre verŝajne, ke la fabrikanto de via aparato limigas la permeson de adb.Eble ekzistas solvo por via sistemo en <b><a href="%1$s">ĉi tiu dokumento</b>.]]></string>
