    <string name="home_wireless_adb_title">ওয়্যারলেস ডিবাগিংয়ের মাধ্যমে শুরু করুন</string>
    <string name="home_wireless_adb_description">Android 11 বা তার উপরে, আপনি ওয়্যারলেস ডিবাগিং সক্ষম করে এবং কোনো কম্পিউটারের সাথে সংযুক্ত না করেই সরাসরি আপনার ডিভাইস থেকে Shevery চালু করতে পারেন। প্রথমে অনুগ্রহ করে ধাপে ধাপে গাইডটি দেখুন।</string>
    <string name="home_wireless_adb_description_pre_11">Android 11-এর আগে, ওয়্যারলেস ডিবাগিং সক্ষম করতে কম্পিউটারের সাথে সংযোগ করা আবশ্যক ছিল।</string>
    <string name="home_wireless_adb_view_guide_button">ধাপ-ধাপ নির্দেশিকা</string>
