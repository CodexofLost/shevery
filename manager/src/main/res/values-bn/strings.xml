    <string name="dialog_adb_discovery">ওয়্যারলেস ডিবাগিং সেবার সন্ধান</string>
    <string name="dialog_adb_discovery_message">অনুগ্রহ করে "Developer options"-এ "Wireless debugging" সক্ষম করুন। নেটওয়ার্ক পরিবর্তনের সময় "Wireless debugging" স্বয়ংক্রিয়ভাবে নিষ্ক্রিয় হয়ে যায়।  দ্রষ্টব্য: "Developer options" বা "USB debugging" নিষ্ক্রিয় করবেন না, নাহলে Shevery বন্ধ হয়ে যাবে।</string>
    <string name="dialog_adb_discovery_message_toggle_wireless_debugging">যদি এটি বারবার অনুসন্ধান করে, তাহলে অনুগ্রহ করে "ওয়্যারলেস ডিবাগিং" বন্ধ করে পুনরায় চালু করার চেষ্টা করুন।</string>
