    <string name="dialog_wireless_adb_not_enabled">ওয়্যারলেস ডিবাগিং সক্ষম করা হয়নি।\nদ্রষ্টব্য, Android 11-এর আগে, ওয়্যারলেস ডিবাগিং সক্ষম করতে কম্পিউটার সংযোগ আবশ্যক।</string>
    <string name="dialog_adb_pairing_message">অনুগ্রহ করে নিম্নলিখিত ধাপগুলি অনুসরণ করে পেয়ারিং শুরু করুন: "Developer Options" - "Wireless debugging" - "Pairing device using pairing code"। পেয়ারিং প্রক্রিয়া শুরু হওয়ার পর আপনি পেয়ারিং কোড ইনপুট করতে পারবেন।</string>
    <string name="adb_pairing_requires_multi_window">অনুগ্রহ করে প্রথমে স্প্লিট-স্ক্রিন (মাল্টি-উইন্ডো) মোডে প্রবেশ করুন।</string>
    <string name="adb_pairing_requires_multi_window_reason">সিস্টেমটি পেয়ারিং ডায়ালগ সবসময় দৃশ্যমান রাখার প্রয়োজন; স্প্লিট-স্ক্রিন মোড ব্যবহার করাই একমাত্র উপায় যা এই অ্যাপ এবং সিস্টেম ডায়ালগকে একসঙ্গে দৃশ্যমান রাখে।</string>
    <string name="adb_error_key_store">ওয়্যারলেস ডিবাগিংয়ের জন্য কী তৈরি করতে পারছে না।\nএটি হতে পারে যে এই ডিভাইসের KeyStore মেকানিজম ভেঙে গেছে।</string>
    <string name="adb_pair_required">অনুগ্রহ করে প্রথমে পেয়ারিং ধাপটি সম্পন্ন করুন।</string>
